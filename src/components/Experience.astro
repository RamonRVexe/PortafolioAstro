---
import ExperienceItem from './ExperienceItem.astro';

const EXPERIENCE = [
	{
		date: 'Enero 2023 — Actualidad · Hermosillo, Sonora',
		title: 'Desarrollador Full Stack',
		company: 'Gobierno del Estado de Sonora',
		highlights: [
			'Desarrollo de módulos complejos en Angular con formularios reactivos, validaciones dinámicas y arquitectura modular.',
			'Diseño e implementación de APIs RESTful con ASP.NET y Python (Falcon).',
			'Integración de procesos backend con SQL Server y procedimientos almacenados.',
			'Optimización de procesos administrativos y mejora de experiencia de usuario.',
			'Implementación de nuevas funcionalidades, mantenimiento correctivo y mejora continua.',
			'Participación en análisis técnico y definición de soluciones institucionales.',
		],
		tags: ['Angular', 'ASP.NET', 'C#', 'Falcon', 'SQL Server', 'REST APIs'],
	},
	{
		date: 'Junio 2021 — Diciembre 2022 · México',
		title: 'Desarrollador Web Full Stack',
		company: 'Tecnergy',
		highlights: [
			'Desarrollo de aplicaciones web utilizando Angular, Laravel, PHP y SQL.',
			'Modernización de sistemas heredados mejorando rendimiento y experiencia de usuario.',
			'Optimización frontend y consultas SQL reduciendo tiempos de carga aproximadamente un 30%.',
			'Implementación de lógica backend y administración de bases de datos.',
		],
		tags: ['Angular', 'Laravel', 'PHP', 'SQL', 'MySQL'],
	},
	{
		date: 'Enero 2021 — Junio 2021 · México',
		title: 'Desarrollador Web',
		company: 'Interlogic',
		highlights: [
			'Desarrollo de sistema de monitoreo para registros de errores en cajeros automáticos.',
			'Implementación backend utilizando PHP y Python.',
			'Diseño de interfaces frontend con HTML, CSS y JavaScript.',
		],
		tags: ['PHP', 'Python', 'JavaScript', 'HTML', 'CSS'],
	},
];
---

<ol class="relative border-l-2 border-surface-border ml-2 sm:ml-3 space-y-2">
	{
		EXPERIENCE.map((item, i) => (
			<li class={`reveal reveal-delay-${(i % 4) + 1} mb-8 sm:mb-10 ms-5 sm:ms-6`}>
				<ExperienceItem {...item} />
			</li>
		))
	}
</ol>
