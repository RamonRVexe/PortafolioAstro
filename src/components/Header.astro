---
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
	{ href: '#about', label: 'Sobre mí' },
	{ href: '#habilidades', label: 'Habilidades' },
	{ href: '#experiencia', label: 'Experiencia' },
	{ href: '#proyectos', label: 'Proyectos' },
	{ href: '#educacion', label: 'Educación' },
	{ href: '#contacto', label: 'Contacto' },
];
---

<header
	class="sticky top-0 z-50 w-full border-b border-transparent transition-all duration-300"
>
	<div class="px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
		<div class="flex items-center justify-between h-14 sm:h-16 gap-2">
			<a
				href="#top"
				class="font-bold text-base sm:text-lg tracking-tight text-primary hover:text-accent transition-colors shrink-0"
				aria-label="Ir al inicio"
			>
				<span class="text-accent">R</span>amón<span class="text-muted font-normal">.dev</span>
			</a>

			<nav class="hidden lg:flex items-center gap-0.5" aria-label="Navegación principal">
				{
					navLinks.map((link) => (
						<a
							href={link.href}
							class="nav-link px-2.5 xl:px-3 py-2 text-sm text-muted hover:text-primary rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-all duration-200"
						>
							{link.label}
						</a>
					))
				}
			</nav>

			<div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
				<ThemeToggle />

				<a
					href="#contacto"
					class="hidden sm:inline-flex items-center px-3 sm:px-4 py-2 text-xs sm:text-sm font-semibold text-white bg-accent hover:bg-accent-dark rounded-lg transition-all duration-200 hover:shadow-lg hover:shadow-accent/25"
				>
					Contáctame
				</a>

				<button
					id="menu-btn"
					type="button"
					class="lg:hidden flex items-center justify-center size-9 sm:size-10 rounded-lg text-secondary hover:text-primary hover:bg-black/5 dark:hover:bg-white/10 transition-colors"
					aria-label="Abrir menú"
					aria-expanded="false"
					aria-controls="mobile-menu"
				>
					<svg id="menu-icon-open" class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
					</svg>
					<svg id="menu-icon-close" class="size-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
					</svg>
				</button>
			</div>
		</div>
	</div>

	<div
		id="mobile-menu"
		class="lg:hidden hidden border-t border-surface-border bg-surface/95 backdrop-blur-xl"
	>
		<nav class="flex flex-col px-4 py-3 gap-0.5 max-h-[70vh] overflow-y-auto" aria-label="Navegación móvil">
			{
				navLinks.map((link) => (
					<a
						href={link.href}
						class="mobile-nav-link px-4 py-3 text-secondary hover:text-primary hover:bg-black/5 dark:hover:bg-white/5 rounded-lg transition-colors text-sm"
					>
						{link.label}
					</a>
				))
			}
			<a
				href="#contacto"
				class="mt-2 px-4 py-3 text-center text-sm font-semibold text-white bg-accent rounded-lg hover:bg-accent-dark transition-colors sm:hidden"
			>
				Contáctame
			</a>
		</nav>
	</div>
</header>

<script>
	const menuBtn = document.getElementById('menu-btn');
	const mobileMenu = document.getElementById('mobile-menu');
	const iconOpen = document.getElementById('menu-icon-open');
	const iconClose = document.getElementById('menu-icon-close');

	const closeMenu = () => {
		mobileMenu?.classList.add('hidden');
		menuBtn?.setAttribute('aria-expanded', 'false');
		iconOpen?.classList.remove('hidden');
		iconClose?.classList.add('hidden');
	};

	menuBtn?.addEventListener('click', () => {
		const isOpen = mobileMenu?.classList.toggle('hidden') === false;
		menuBtn.setAttribute('aria-expanded', String(isOpen));
		iconOpen?.classList.toggle('hidden', isOpen);
		iconClose?.classList.toggle('hidden', !isOpen);
	});

	document.querySelectorAll('.mobile-nav-link').forEach((link) => {
		link.addEventListener('click', closeMenu);
	});

	const sections = document.querySelectorAll('section[id]');
	const navLinks = document.querySelectorAll('.nav-link');

	const setActiveNav = () => {
		let current = '';
		sections.forEach((section) => {
			const top = section.getBoundingClientRect().top;
			if (top <= 120) current = section.id;
		});
		navLinks.forEach((link) => {
			const href = link.getAttribute('href');
			link.classList.toggle('active', href === `#${current}`);
		});
	};

	window.addEventListener('scroll', setActiveNav, { passive: true });
	setActiveNav();
</script>
