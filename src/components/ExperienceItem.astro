---
export interface Props {
	date: string;
	title: string;
	company: string;
	description?: string;
	highlights?: string[];
	tags?: string[];
	link?: string;
}

const { date, title, company, description, highlights = [], tags = [], link } = Astro.props;
---

<div class="absolute -start-[25px] sm:-start-[31px] flex items-center justify-center size-3.5 sm:size-4 rounded-full bg-accent border-4 border-surface ring-2 ring-accent/30"></div>
<time class="text-xs font-mono text-accent uppercase tracking-wider">{date}</time>
<h3 class="text-base sm:text-lg font-bold text-primary mt-1">{title}</h3>
<p class="text-sm text-muted font-medium mb-2">{company}</p>
{
	highlights.length > 0 ? (
		<ul class="text-secondary text-sm leading-relaxed space-y-1.5 list-disc list-outside ms-4">
			{highlights.map((item) => (
				<li class="text-pretty">{item}</li>
			))}
		</ul>
	) : (
		description && <p class="text-secondary text-sm leading-relaxed text-pretty">{description}</p>
	)
}
{
	tags.length > 0 && (
		<div class="flex flex-wrap gap-1.5 sm:gap-2 mt-3">
			{tags.map((tag) => (
				<span class="px-2 py-0.5 text-xs font-mono text-muted bg-black/5 dark:bg-white/5 rounded border border-black/5 dark:border-white/5">
					{tag}
				</span>
			))}
		</div>
	)
}
{
	link && (
		<a
			href={link}
			target="_blank"
			rel="noopener noreferrer"
			class="inline-flex items-center gap-2 mt-4 text-sm font-medium text-accent hover:text-primary transition-colors"
		>
			Saber más
			<svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
			</svg>
		</a>
	)
}
