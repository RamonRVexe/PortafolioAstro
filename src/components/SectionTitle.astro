---
interface Props {
	icon?: any;
	title: string;
	subtitle?: string;
}

const { icon: Icon, title, subtitle } = Astro.props;
---

<div class="reveal mb-8 sm:mb-10">
	<div class="flex items-center gap-3 mb-2">
		{Icon && (
			<span class="flex items-center justify-center size-9 sm:size-10 rounded-xl bg-accent/10 text-accent border border-accent/20 shrink-0">
				<Icon class="size-4 sm:size-5" />
			</span>
		)}
		<h2 class="text-xl sm:text-2xl md:text-3xl font-bold text-primary tracking-tight">{title}</h2>
	</div>
	{subtitle && (
		<p class={`text-muted text-sm md:text-base max-w-xl ${Icon ? 'sm:ml-[52px]' : ''}`}>{subtitle}</p>
	)}
</div>
