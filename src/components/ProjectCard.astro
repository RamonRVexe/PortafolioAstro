---
export interface Props {
	title: string;
	description: string;
	tags: string[];
	href?: string;
	accent?: 'indigo' | 'purple' | 'blue' | 'emerald' | 'amber';
}

const { title, description, tags, href, accent = 'indigo' } = Astro.props;

const accentMap = {
	indigo: {
		shadow: 'bg-indigo-500',
		border: 'border-indigo-400/60 dark:border-indigo-500/50',
		tag: 'text-indigo-700 dark:text-indigo-300 bg-indigo-50 dark:bg-indigo-500/10 border-indigo-200 dark:border-indigo-500/20',
	},
	purple: {
		shadow: 'bg-purple-500',
		border: 'border-purple-400/60 dark:border-purple-500/50',
		tag: 'text-purple-700 dark:text-purple-300 bg-purple-50 dark:bg-purple-500/10 border-purple-200 dark:border-purple-500/20',
	},
	blue: {
		shadow: 'bg-blue-500',
		border: 'border-blue-400/60 dark:border-blue-500/50',
		tag: 'text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-500/10 border-blue-200 dark:border-blue-500/20',
	},
	emerald: {
		shadow: 'bg-emerald-500',
		border: 'border-emerald-400/60 dark:border-emerald-500/50',
		tag: 'text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-500/10 border-emerald-200 dark:border-emerald-500/20',
	},
	amber: {
		shadow: 'bg-amber-500',
		border: 'border-amber-400/60 dark:border-amber-500/50',
		tag: 'text-amber-700 dark:text-amber-300 bg-amber-50 dark:bg-amber-500/10 border-amber-200 dark:border-amber-500/20',
	},
};

const colors = accentMap[accent];
---

<article class="reveal group relative h-full">
	<span
		class={`absolute inset-0 translate-x-1 translate-y-1 rounded-2xl ${colors.shadow} opacity-40 dark:opacity-60 group-hover:translate-x-1.5 group-hover:translate-y-1.5 transition-transform duration-300`}
	></span>
	<div
		class={`relative flex flex-col h-full p-5 sm:p-6 rounded-2xl bg-surface-raised border-2 ${colors.border} shadow-sm dark:shadow-none transition-all duration-300 group-hover:-translate-x-0.5 group-hover:-translate-y-0.5`}
	>
		<h3 class="text-base sm:text-lg font-bold text-primary mb-2 group-hover:text-accent transition-colors">
			{title}
		</h3>
		<p class="text-muted text-sm leading-relaxed flex-grow mb-4">{description}</p>
		<div class="flex flex-wrap gap-1.5 sm:gap-2 mb-4">
			{tags.map((tag) => (
				<span class={`px-2 py-0.5 text-xs font-mono rounded-md border ${colors.tag}`}>{tag}</span>
			))}
		</div>
		{href ? (
			<a
				href={href}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-accent transition-colors mt-auto"
			>
				Ver más
				<svg class="size-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
				</svg>
			</a>
		) : (
			<span class="text-xs text-muted font-mono mt-auto">Proyecto institucional / privado</span>
		)}
	</div>
</article>
