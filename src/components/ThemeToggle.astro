<button
	id="theme-toggle"
	type="button"
	class="theme-toggle flex items-center justify-center size-10 rounded-lg border border-surface-border bg-surface-raised/80 text-secondary hover:text-primary hover:border-accent/40 hover:bg-accent/10 transition-all duration-200"
	aria-label="Cambiar tema"
	title="Cambiar tema"
>
	<svg id="icon-sun" class="size-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
	</svg>
	<svg id="icon-moon" class="size-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
	</svg>
</button>

<script>
	const toggle = document.getElementById('theme-toggle');
	const root = document.documentElement;

	const applyTheme = (theme: 'light' | 'dark') => {
		root.classList.toggle('dark', theme === 'dark');
		localStorage.setItem('theme', theme);
	};

	toggle?.addEventListener('click', () => {
		const next = root.classList.contains('dark') ? 'light' : 'dark';
		applyTheme(next);
	});
</script>
