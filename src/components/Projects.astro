---
import ProjectCard from './ProjectCard.astro';

const PROJECTS = [
	{
		title: 'Plataforma de Crédito Educativo',
		description:
			'Sistema institucional para gestión de solicitudes de crédito educativo. Formularios multipaso con validaciones complejas, gestión de renovaciones, cambios de estatus y seguimiento de solicitudes. Integración mediante APIs RESTful y procedimientos almacenados.',
		tags: ['Angular', 'ASP.NET', 'SQL Server', 'REST APIs'],
		accent: 'indigo' as const,
	},
	{
		title: 'Sistema de Control de Acceso',
		description:
			'Plataforma institucional para validación y registro de accesos mediante códigos QR y códigos de barras. Frontend en Angular con validación en tiempo real, APIs de autorización y auditoría, integración con SQL Server para credenciales y bitácoras.',
		tags: ['Angular', 'ASP.NET', 'SQL Server', 'QR / Barcode'],
		accent: 'purple' as const,
	},
	{
		title: 'Sistema de monitoreo ATM',
		description:
			'Sistema de monitoreo para registros de errores en cajeros automáticos. Backend en PHP y Python con interfaces frontend en HTML, CSS y JavaScript para revisión técnica de incidencias.',
		tags: ['PHP', 'Python', 'JavaScript', 'HTML/CSS'],
		accent: 'blue' as const,
	},
];
---

<div class="grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-8">
	{PROJECTS.map((project) => <ProjectCard {...project} />)}
</div>
